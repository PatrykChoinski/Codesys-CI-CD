# CODESYS working files
*.opt
*.~u
*.precompilecache
# Published-symbols XML, regenerated by every generate_code()/compile
*.Device.Application.xml

# CI artifacts
/build/
/reports/*
!/reports/.gitkeep
/work/
*.log

# CODESYS installers (licensed download, not committed to git)
installers/*
!installers/README.md

# Project archive: only used to "prime" the device repository (see
# scripts/codesys_build.py) - regenerated locally with
# scripts/Update-ProjectArchive.ps1 and uploaded to a GitHub Release
# asset (too large for git, see README.md), not committed.
*.projectarchive

# Local CODESYS MCP server config (machine-specific paths, see CLAUDE.md)
.mcp.json
